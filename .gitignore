# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are intentionally unanchored so they apply at the root and inside
# every workspace package (packages/*, apps/*) — Requirement 2.9.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
dist/
build/
storybook-static/

# testing
coverage/

# editor state
.idea/
.vscode/*
!.vscode/extensions.json
*.iml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
