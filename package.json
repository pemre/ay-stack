{
  "name": "ay-stack",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm run test:root",
    "test:root": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "pnpm --filter burkut dev",
    "storybook": "pnpm --filter @ay/ui-library storybook"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pemre/ay-stack.git"
  }
}
