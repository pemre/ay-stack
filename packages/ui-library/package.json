{
  "name": "@ay/ui-library",
  "version": "1.0.0",
  "description": "🌜 Ay UI Library — Design tokens, dashboard infrastructure, and reusable React blocks",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dashboard": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./styles.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./core.css": "./dist/core.css",
    "./semantic.css": "./dist/semantic.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "TOKEN-ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "STORYBOOK=true storybook dev -p 6006",
    "build": "vite build && node scripts/build-tokens-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write src",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "react-markdown": "^9.0.1",
    "react-leaflet": "^4.2.1",
    "remark-gfm": "^4.0.0",
    "vis-data": "^7.1.9",
    "vis-timeline": "^7.7.3",
    "react-grid-layout": "^2.2.2",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "d3": "^7.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^28.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "d3": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-grid-layout": "^2.2.2",
    "storybook": "^8.6.18",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "catalog:",
    "zustand": "^5.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pemre/ay-stack.git",
    "directory": "packages/ui-library"
  }
}
