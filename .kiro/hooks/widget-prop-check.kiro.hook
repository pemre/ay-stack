{
  "enabled": true,
  "name": "Widget Prop Check",
  "description": "After editing widget panel components or WidgetGrid, checks for type errors to catch missing prop mismatches early.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/components/WidgetGrid/WidgetGrid.tsx",
      "src/components/TimelinePanel/TimelinePanel.tsx",
      "src/components/Sidebar/Sidebar.tsx",
      "src/components/ContentPanel/ContentPanel.tsx",
      "src/components/MapPanel/MapPanel.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check for type diagnostics in the edited file and in src/components/WidgetGrid/WidgetGrid.tsx. If any widget component's props interface changed, verify that WidgetGrid's renderWidgetContent passes all required props for that widget type. Report any missing props."
  }
}